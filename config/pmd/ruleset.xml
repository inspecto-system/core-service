<?xml version="1.0"?>
<ruleset name="Inspecto core-service"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Bug-prone code, unused code, design and security rules (CODE_QUALITY.md).</description>

    <rule ref="category/java/bestpractices.xml">
        <!-- JUnit 5 test classes and methods are package-private by convention -->
        <exclude name="JUnit5TestShouldBePackagePrivate"/>
        <exclude name="GuardLogStatement"/>
        <!-- One behaviour per test is enforced by review; several MockMvc expectations per test are fine -->
        <exclude name="UnitTestContainsTooManyAsserts"/>
    </rule>
    <rule ref="category/java/bestpractices.xml/UnitTestShouldIncludeAssert">
        <properties>
            <!-- MockMvc expectations are assertions -->
            <property name="extraAssertMethodNames" value="andExpect"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="MissingSerialVersionUID"/>
        <!-- Nullable columns (for example locked_until) are cleared by assigning null -->
        <exclude name="NullAssignment"/>
    </rule>
    <rule ref="category/java/security.xml"/>
    <rule ref="category/java/errorprone.xml/MissingStaticMethodInNonInstantiatableClass">
        <properties>
            <!-- Holder classes of request/response records (*Dtos) are namespaces, not utilities -->
            <property name="violationSuppressXPath" value="//ClassDeclaration[ends-with(@SimpleName, 'Dtos')]"/>
        </properties>
    </rule>
    <rule ref="category/java/multithreading.xml">
        <exclude name="UseConcurrentHashMap"/>
        <exclude name="DoNotUseThreads"/>
    </rule>
    <rule ref="category/java/performance.xml"/>

    <rule ref="category/java/design.xml/CyclomaticComplexity"/>
    <rule ref="category/java/design.xml/CognitiveComplexity"/>
    <rule ref="category/java/design.xml/GodClass"/>
    <rule ref="category/java/design.xml/SimplifyBooleanReturns"/>
    <rule ref="category/java/design.xml/SingularField"/>
    <rule ref="category/java/design.xml/ImmutableField"/>
    <rule ref="category/java/design.xml/AvoidThrowingRawExceptionTypes"/>
    <rule ref="category/java/design.xml/SignatureDeclareThrowsException">
        <properties>
            <property name="IgnoreJUnitCompletely" value="true"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="6"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/UseUtilityClass">
        <properties>
            <!-- Spring Boot application entry point -->
            <property name="violationSuppressXPath"
                      value="//ClassDeclaration[pmd-java:hasAnnotation('org.springframework.boot.autoconfigure.SpringBootApplication')]"/>
        </properties>
    </rule>
</ruleset>
